class CryptoTest {

  @Test
  void roundTripAndFreshNonce() throws Exception {
    Envelope e = new Envelope();
    byte[] salt = CryptoEngine.random(16),
        key = CryptoEngine.derive("password".toCharArray(), salt, 1000),
        plain = "Қазақша мәтін".getBytes(java.nio.charset.StandardCharsets.UTF_8);
    byte[] a = e.seal(key, salt, 1000, plain), b = e.seal(key, salt, 1000, plain);
    assertFalse(Arrays.equals(a, b));
    assertArrayEquals(plain, e.open(a, "password".toCharArray()).plain());
  }

  @Test
  void rejectsWrongPasswordAndTampering() throws Exception {
    Envelope e = new Envelope();
    byte[] salt = CryptoEngine.random(16),
        key = CryptoEngine.derive("password".toCharArray(), salt, 1000);
    byte[] bytes = e.seal(key, salt, 1000, new byte[] {1, 2, 3});
    assertThrows(VaultException.class, () -> e.open(bytes, "bad".toCharArray()));
    bytes[bytes.length - 1] ^= 1;
    assertThrows(VaultException.class, () -> e.open(bytes, "password".toCharArray()));
  }

  @Test
  void authenticatesHeaderAndBounds() throws Exception {
    Envelope e = new Envelope();
    byte[] salt = CryptoEngine.random(16),
        key = CryptoEngine.derive("password".toCharArray(), salt, 1000);
    byte[] bytes = e.seal(key, salt, 1000, new byte[] {1});
    bytes[10] ^= 1;
    assertThrows(VaultException.class, () -> e.open(bytes, "password".toCharArray()));
    assertThrows(VaultException.class, () -> e.open(new byte[3], new char[0]));
    assertThrows(
        VaultException.class, () -> CryptoEngine.derive(new char[0], salt, Integer.MAX_VALUE));
  }
}


