package kz.vault.storage;

import java.nio.file.Path;
import java.sql.*;
import java.util.Optional;

public final class SqliteVaultDao implements VaultDao {
  private final String url;

  public SqliteVaultDao(Path file) throws SQLException {
    url = "jdbc:sqlite:" + file.toAbsolutePath();
    try (Connection c = connect();
        Statement s = c.createStatement()) {
      s.executeUpdate(
          "CREATE TABLE IF NOT EXISTS vault(id INTEGER PRIMARY KEY CHECK(id=1),payload BLOB NOT"
              + " NULL)");
      s.executeUpdate(
          "CREATE TABLE IF NOT EXISTS audit(id INTEGER PRIMARY KEY AUTOINCREMENT,action TEXT NOT"
              + " NULL,created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP)");
    }
  }

  private Connection connect() throws SQLException {
    Connection c = DriverManager.getConnection(url);
    try (Statement s = c.createStatement()) {
      s.execute("PRAGMA busy_timeout=5000");
    }
    return c;
  }

  public Optional<byte[]> load() throws SQLException {
    try (Connection c = connect();
        PreparedStatement p = c.prepareStatement("SELECT payload FROM vault WHERE id=1");
        ResultSet r = p.executeQuery()) {
      return r.next() ? Optional.of(r.getBytes(1)) : Optional.empty();
    }
  }

  // Деректі сақтау мен audit — бір транзакция. Кез келген қате болса rollback.
  public void save(byte[] encrypted, boolean create) throws SQLException {
    try (Connection c = connect()) {
      c.setAutoCommit(false);
      try {
        String sql =
            create
                ? "INSERT INTO vault(id,payload) VALUES(1,?)"
                : "UPDATE vault SET payload=? WHERE id=1";
        try (PreparedStatement p = c.prepareStatement(sql)) {
          p.setBytes(1, encrypted);
          if (p.executeUpdate() != 1) throw new SQLException("Қойма жоқ");
        }
        try (PreparedStatement p = c.prepareStatement("INSERT INTO audit(action) VALUES(?)")) {
          p.setString(1, create ? "CREATE" : "SAVE");
          p.executeUpdate();
        }
        c.commit();
      } catch (SQLException e) {
        try {
          c.rollback();
        } catch (SQLException r) {
          e.addSuppressed(r);
        }
        throw e;
      }
    }
  }
}


