package kz.vault.model;

import java.time.LocalDateTime;
import java.util.*;

public abstract class VaultRecord implements Searchable {
  private final int id;
  private final String title, note, createdAt, updatedAt;

  protected VaultRecord(int id, String title, String note, String createdAt, String updatedAt) {
    if (id < 1 || title == null || title.isBlank())
      throw new IllegalArgumentException("ID және атау дұрыс болуы керек");
    this.id = id;
    this.title = title;
    this.note = Objects.requireNonNull(note);
    this.createdAt = Objects.requireNonNull(createdAt);
    this.updatedAt = Objects.requireNonNull(updatedAt);
  }

  protected VaultRecord(int id, String title, String note) {
    this(id, title, note, now(), now());
  }

  protected static String now() {
    return LocalDateTime.now().withNano(0).toString();
  }

  public int getId() {
    return id;
  }

  public String getTitle() {
    return title;
  }

  public String getNote() {
    return note;
  }

  public String getCreatedAt() {
    return createdAt;
  }

  public String getUpdatedAt() {
    return updatedAt;
  }

  public abstract RecordType getType();

  public abstract String details();

  public abstract VaultRecord edited(Map<String, String> changes);

  public String describe() {
    return "#" + id + " [" + getType() + "] " + title;
  }

  public boolean matches(String q) {
    String s = q.toLowerCase(Locale.ROOT);
    return title.toLowerCase(Locale.ROOT).contains(s) || note.toLowerCase(Locale.ROOT).contains(s);
  }

  public Map<String, String> toMap() {
    Map<String, String> m = new LinkedHashMap<>();
    m.put("id", "" + id);
    m.put("type", getType().name());
    m.put("title", title);
    m.put("note", note);
    m.put("createdAt", createdAt);
    m.put("updatedAt", updatedAt);
    return m;
  }

  public static VaultRecord fromMap(Map<String, String> m) {
    int id = Integer.parseInt(m.get("id"));
    return switch (RecordType.valueOf(m.get("type"))) {
      case NOTE ->
          new NoteRecord(id, m.get("title"), m.get("note"), m.get("createdAt"), m.get("updatedAt"));
      case PASSWORD ->
          new PasswordRecord(
              id,
              m.get("title"),
              m.get("login"),
              m.get("secret"),
              m.get("note"),
              m.get("createdAt"),
              m.get("updatedAt"));
    };
  }
}


