package kz.vault.model;

import java.util.*;

// Immutable жазбалар: экспортқа алынған snapshot кейін өзгермейді.
public final class Repository<T extends VaultRecord> {
  private final Map<Integer, T> data = new LinkedHashMap<>();

  public void add(T item) {
    if (data.putIfAbsent(item.getId(), item) != null)
      throw new IllegalArgumentException("ID қайталанады");
  }

  public void replace(T item) {
    if (!data.containsKey(item.getId())) throw new IllegalArgumentException("Жазба жоқ");
    data.put(item.getId(), item);
  }

  public Optional<T> find(int id) {
    return Optional.ofNullable(data.get(id));
  }

  public boolean delete(int id) {
    return data.remove(id) != null;
  }

  public List<T> all() {
    return List.copyOf(data.values());
  }

  public Set<RecordType> types() {
    Set<RecordType> result = EnumSet.noneOf(RecordType.class);
    data.values().forEach(r -> result.add(r.getType()));
    return result;
  }

  public int nextId() {
    return Math.addExact(data.keySet().stream().mapToInt(Integer::intValue).max().orElse(0), 1);
  }
}


