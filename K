package kz.vault.crypto;

import java.nio.ByteBuffer;
import java.util.Arrays;

public final class Envelope {
  public static final int HEADER = 37, ITERATIONS = 200000;
  private final Encryptor crypto = new CryptoEngine();

  public byte[] seal(byte[] key, byte[] salt, int iterations, byte[] plain) throws VaultException {
    byte[] nonce = CryptoEngine.random(12);
    byte[] header =
        ByteBuffer.allocate(HEADER)
            .put(new byte[] {'K', 'V', 'L', 'T'})
            .put((byte) 1)
            .putInt(iterations)
            .put(salt)
            .put(nonce)
            .array();
    byte[] cipher = crypto.encrypt(key, nonce, plain, header);
    return ByteBuffer.allocate(HEADER + cipher.length).put(header).put(cipher).array();
  }

  public record Opened(byte[] key, byte[] salt, int iterations, byte[] plain) {}

  public Opened open(byte[] bytes, char[] password) throws VaultException {
    if (bytes.length < HEADER + 16) throw new VaultException("Файл тым қысқа");
    ByteBuffer b = ByteBuffer.wrap(bytes);
    byte[] magic = new byte[4];
    b.get(magic);
    if (!Arrays.equals(magic, new byte[] {'K', 'V', 'L', 'T'}) || b.get() != 1)
      throw new VaultException("Формат қолдау таппайды");
    int iterations = b.getInt();
    byte[] salt = new byte[16], nonce = new byte[12];
    b.get(salt);
    b.get(nonce);
    byte[] key = CryptoEngine.derive(password, salt, iterations);
    try {
      return new Opened(
          key,
          salt,
          iterations,
          crypto.decrypt(
              key,
              nonce,
              Arrays.copyOfRange(bytes, HEADER, bytes.length),
              Arrays.copyOf(bytes, HEADER)));
    } catch (VaultException e) {
      Arrays.fill(key, (byte) 0);
      throw e;
    }
  }
}


