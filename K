package kz.vault.service;

import com.fasterxml.jackson.databind.*;
import java.nio.file.*;
import java.util.*;
import kz.vault.crypto.*;
import kz.vault.model.*;
import kz.vault.storage.*;

public final class VaultService implements AutoCloseable {
  private final VaultDao dao;
  private final ObjectMapper mapper =
      new ObjectMapper().enable(DeserializationFeature.FAIL_ON_TRAILING_TOKENS);
  private final Envelope envelope = new Envelope();
  private Repository<VaultRecord> records = new Repository<>();
  private byte[] key, salt;
  private int iterations;

  public VaultService(VaultDao dao) {
    this.dao = dao;
  }

  public synchronized boolean isOpen() {
    return key != null;
  }

  private void requireOpen() {
    if (!isOpen()) throw new IllegalStateException("Қойма ашылмаған");
  }

  public synchronized void create(char[] password) throws Exception {
    if (password.length < 8) throw new IllegalArgumentException("Кемінде 8 таңба керек");
    if (dao.load().isPresent()) throw new IllegalStateException("Қойма бар");
    close();
    salt = CryptoEngine.random(16);
    iterations = Envelope.ITERATIONS;
    key = CryptoEngine.derive(password, salt, iterations);
    try {
      persist(true);
    } catch (Exception e) {
      close();
      throw e;
    }
  }

  public synchronized void open(char[] password) throws Exception {
    loadBytes(dao.load().orElseThrow(() -> new IllegalStateException("Қойма жоқ")), password);
  }

  private void loadBytes(byte[] bytes, char[] password) throws Exception {
    Envelope.Opened opened = envelope.open(bytes, password);
    try {
      JsonNode root = mapper.readTree(opened.plain());
      if (!root.isObject() || !root.path("records").isArray())
        throw new VaultException("JSON құрылымы қате");
      Repository<VaultRecord> candidate = new Repository<>();
      for (JsonNode node : root.get("records")) {
        if (!node.isObject()) throw new VaultException("Жазба құрылымы қате");
        Map<String, String> m = new LinkedHashMap<>();
        var fields = node.fields();
        while (fields.hasNext()) {
          var f = fields.next();
          if (!f.getValue().isTextual()) throw new VaultException("Жол күтілді");
          m.put(f.getKey(), f.getValue().asText());
        }
        candidate.add(VaultRecord.fromMap(m));
      }
      close();
      records = candidate;
      key = opened.key();
      salt = opened.salt();
      iterations = opened.iterations();
    } catch (Exception e) {
      Arrays.fill(opened.key(), (byte) 0);
      throw e;
    } finally {
      Arrays.fill(opened.plain(), (byte) 0);
    }
  }

  // Бастапқы KVLT .vault файлын бос SQLite қоймасына көшіру.
  public synchronized void importLegacy(Path file, char[] password) throws Exception {
    if (dao.load().isPresent() || isOpen())
      throw new IllegalStateException("Импортқа бос қойма керек");
    loadBytes(Files.readAllBytes(file), password);
    try {
      persist(true);
    } catch (Exception e) {
      close();
      throw e;
    }
  }

  private byte[] encrypted() throws Exception {
    requireOpen();
    byte[] plain =
        mapper.writeValueAsBytes(
            Map.of(
                "nextId",
                "" + records.nextId(),
                "records",
                records.all().stream().map(VaultRecord::toMap).toList()));
    try {
      return envelope.seal(key, salt, iterations, plain);
    } finally {
      Arrays.fill(plain, (byte) 0);
    }
  }

  private void persist(boolean create) throws Exception {
    dao.save(encrypted(), create);
  }

  public synchronized void save() throws Exception {
    persist(false);
  }

  public synchronized List<VaultRecord> all() {
    requireOpen();
    return records.all();
  }

  public synchronized void addNote(String title, String text) {
    requireOpen();
    records.add(new NoteRecord(records.nextId(), title, text));
  }

  public synchronized void addPassword(String title, String login, String secret, String note) {
    requireOpen();
    records.add(new PasswordRecord(records.nextId(), title, login, secret, note));
  }

  public synchronized void edit(int id, Map<String, String> changes) {
    requireOpen();
    VaultRecord r = records.find(id).orElseThrow(() -> new IllegalArgumentException("Жазба жоқ"));
    records.replace(r.edited(changes));
  }

  public synchronized boolean delete(int id) {
    requireOpen();
    return records.delete(id);
  }

  public synchronized void close() {
    if (key != null) Arrays.fill(key, (byte) 0);
    key = null;
    salt = null;
    records = new Repository<>();
  }
}


