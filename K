package kz.vault.app;

import java.nio.file.*;
import java.util.*;
import kz.vault.model.*;
import kz.vault.service.*;
import kz.vault.storage.*;

public final class Main {
  private static final Scanner IN = new Scanner(System.in);

  public static String normalizedChoice(String value) {
    return value.trim();
  }

  public static boolean shouldSave(String value) {
    return value.isBlank() || value.equalsIgnoreCase("y");
  }

  public static String[] editableFields(RecordType type) {
    return type == RecordType.PASSWORD
        ? new String[] {"title", "login", "secret", "note"}
        : new String[] {"title", "note"};
  }

  private static String line(String prompt) {
    System.out.print(prompt);
    return IN.nextLine();
  }

  private static char[] password() {
    var c = System.console();
    if (c != null) return c.readPassword("Master-пароль: ");
    System.out.println("Бұл ортада пароль экранда көрінеді.");
    return line("Master-пароль: ").toCharArray();
  }

  public static void main(String[] args) throws Exception {
    Path database = Path.of(args.length == 0 ? "records.db" : args[0]);
    try (VaultService vault = new VaultService(new SqliteVaultDao(database));
        ReportService reports = new ReportService()) {
      Analytics analytics = new Analytics();
      boolean dirty = false;
      while (true) {
        try {
          if (!vault.isOpen()) {
            System.out.println("1 Жаңа қойма | 2 Ашу | 3 Ескі .vault импорттау | 0 Шығу");
            String c = normalizedChoice(line("> "));
            if (c.equals("0")) return;
            if (!Set.of("1", "2", "3").contains(c)) continue;
            String legacy = c.equals("3") ? line(".vault жолы: ") : null;
            char[] p = password();
            try {
              if (c.equals("1")) {
                char[] repeat = password();
                try {
                  if (!Arrays.equals(p, repeat))
                    throw new IllegalArgumentException("Парольдер сәйкес емес");
                  vault.create(p);
                } finally {
                  Arrays.fill(repeat, ' ');
                }
              } else if (c.equals("2")) vault.open(p);
              else vault.importLegacy(Path.of(legacy), p);
            } finally {
              Arrays.fill(p, ' ');
            }
            dirty = false;
            continue;
          }
          System.out.println(
              "1 Тізім | 2 Пароль қосу | 3 Мәтін қосу | 4 Іздеу | 5 Толық көру | 6 Өзгерту | 7 Жою"
                  + " | 8 Сақтау | 9 Аналитика | 10 CSV (фонда) | 0 Жабу"
                  + (dirty ? " *" : ""));
          switch (normalizedChoice(line("> "))) {
            case "1" -> vault.all().forEach(r -> System.out.println(r.describe()));
            case "2" -> {
              vault.addPassword(
                  line("Атауы: "), line("Логин: "), line("Құпия: "), line("Ескертпе: "));
              dirty = true;
            }
            case "3" -> {
              vault.addNote(line("Атауы: "), line("Мәтін: "));
              dirty = true;
            }
            case "4" -> {
              String q = line("Іздеу: ");
              String t = line("PASSWORD/NOTE немесе бос: ").trim();
              var found =
                  t.isEmpty()
                      ? analytics.search(vault.all(), q)
                      : analytics.search(
                          vault.all(), q, RecordType.valueOf(t.toUpperCase(Locale.ROOT)));
              found.forEach(r -> System.out.println(r.describe()));
            }
            case "5" -> {
              int id = Integer.parseInt(line("ID: "));
              System.out.println(
                  vault.all().stream()
                      .filter(r -> r.getId() == id)
                      .findFirst()
                      .orElseThrow(() -> new IllegalArgumentException("Жазба жоқ"))
                      .details());
            }
            case "6" -> {
              int id = Integer.parseInt(line("ID: "));
              var record =
                  vault.all().stream()
                      .filter(r -> r.getId() == id)
                      .findFirst()
                      .orElseThrow(() -> new IllegalArgumentException("Жазба жоқ"));
              Map<String, String> m = new HashMap<>();
              for (String f : editableFields(record.getType())) {
                String v = line(f + " (Enter = қалдыру): ");
                if (!v.isEmpty()) m.put(f, v);
              }
              if (!m.isEmpty()) {
                vault.edit(id, m);
                dirty = true;
              }
            }
            case "7" -> {
              if (vault.delete(Integer.parseInt(line("ID: ")))) dirty = true;
              else System.out.println("Жазба жоқ");
            }
            case "8" -> {
              vault.save();
              dirty = false;
              System.out.println("Сақталды");
            }
            case "9" -> {
              System.out.println("Саны: " + analytics.counts(vault.all()));
              System.out.println("Түрлері: " + analytics.types(vault.all()));
              System.out.println("Атаулары: " + analytics.titles(vault.all()));
            }
            case "10" -> {
              reports
                  .exportCsv(vault.all(), Path.of("reports"))
                  .whenComplete(
                      (file, error) ->
                          System.out.println(
                              error == null
                                  ? "Есеп дайын: " + file
                                  : "Экспорт қатесі: " + error.getMessage()));
              System.out.println("Экспорт басталды, мәзір қолжетімді.");
            }
            case "0" -> {
              if (dirty && shouldSave(line("Сақтау? y/n [y]: "))) vault.save();
              vault.close();
              dirty = false;
            }
            default -> System.out.println("Қате таңдау");
          }
        } catch (NoSuchElementException e) {
          System.out.println("Енгізу аяқталды. Өзгерістер автоматты сақталмайды.");
          return;
        } catch (Exception e) {
          System.out.println("ҚАТЕ: " + e.getMessage());
        }
      }
    }
  }
}


