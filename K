package kz.vault.service;

import java.util.*;
import java.util.stream.Collectors;
import kz.vault.model.*;

public final class Analytics {
  public List<VaultRecord> search(List<VaultRecord> records, String query) {
    return records.stream().filter(r -> r.matches(query)).toList();
  }

  public List<VaultRecord> search(List<VaultRecord> records, String query, RecordType type) {
    return search(records, query).stream().filter(r -> r.getType() == type).toList();
  }

  public List<String> titles(List<VaultRecord> records) {
    return records.stream().map(VaultRecord::getTitle).toList();
  }

  public Map<RecordType, Long> counts(List<VaultRecord> records) {
    return records.stream()
        .collect(
            Collectors.groupingBy(
                VaultRecord::getType,
                () -> new EnumMap<>(RecordType.class),
                Collectors.counting()));
  }

  public Set<RecordType> types(List<VaultRecord> records) {
    return records.stream().map(VaultRecord::getType).collect(Collectors.toSet());
  }
}


