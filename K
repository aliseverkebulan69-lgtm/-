package kz.vault.service;

import java.io.IOException;
import java.nio.charset.StandardCharsets;
import java.nio.file.*;
import java.util.*;
import java.util.concurrent.*;
import kz.vault.model.*;

public final class ReportService implements AutoCloseable {
  private final ExecutorService executor = Executors.newFixedThreadPool(2);

  // Құпия деректер worker-ге берілмейді. Әр тапсырма жеке файлға жазады.
  public CompletableFuture<Path> exportCsv(List<VaultRecord> records, Path directory) {
    List<String> rows =
        records.stream()
            .map(
                r ->
                    r.getId()
                        + ","
                        + r.getType()
                        + ","
                        + csv(r.getTitle())
                        + ","
                        + csv(r.getCreatedAt())
                        + ","
                        + csv(r.getUpdatedAt()))
            .toList();
    return CompletableFuture.supplyAsync(
        () -> {
          Path tmp = null;
          try {
            Files.createDirectories(directory);
            tmp = Files.createTempFile(directory, ".report-", ".tmp");
            List<String> lines = new ArrayList<>();
            lines.add("id,type,title,createdAt,updatedAt");
            lines.addAll(rows);
            Files.write(tmp, lines, StandardCharsets.UTF_8);
            Path result = directory.resolve("report-" + UUID.randomUUID() + ".csv");
            try {
              Files.move(tmp, result, StandardCopyOption.ATOMIC_MOVE);
            } catch (AtomicMoveNotSupportedException e) {
              Files.move(tmp, result);
            }
            return result;
          } catch (IOException e) {
            throw new CompletionException(e);
          } finally {
            if (tmp != null)
              try {
                Files.deleteIfExists(tmp);
              } catch (IOException ignored) {
              }
          }
        },
        executor);
  }

  private static String csv(String text) {
    // CSV формуласы орындалмауы үшін қауіпті алғашқы таңбаны бейтараптау.
    String s = text;
    String leading = s.stripLeading();
    if (!leading.isEmpty() && "=+-@".indexOf(leading.charAt(0)) >= 0
        || s.startsWith("\t")
        || s.startsWith("\r")) s = "'" + s;
    return "\"" + s.replace("\"", "\"\"") + "\"";
  }

  public void close() {
    executor.shutdown();
    try {
      if (!executor.awaitTermination(30, TimeUnit.SECONDS)) executor.shutdownNow();
    } catch (InterruptedException e) {
      executor.shutdownNow();
      Thread.currentThread().interrupt();
    }
  }
}


